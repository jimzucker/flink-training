    {
      "id": 17,
      "type": "timeseries",
      "title": "Order latency \u2014 trade created to position computed",
      "description": "How old a trade is when its position is computed. This is the pipeline's own work. What a consumer waits for is longer, because a record is not readable until the checkpoint that produced it commits.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 16,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "gradientMode": "opacity"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(flink_taskmanager_job_task_operator_processingLatencyMillis{operator_name=\"aggregate_by_symbol\",quantile=\"0.5\"})",
          "legendFormat": "\u2462 by symbol p50"
        },
        {
