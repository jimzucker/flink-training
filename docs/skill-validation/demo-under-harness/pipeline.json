{
  "project": "duhc",
  "topics": {
    "in": "block-trades",
    "out": [
      "positions-by-symbol",
      "positions-by-account"
    ]
  },
  "partitions": 8,
  "outputsPerInput": 5,
  "checkpointMs": 5000,
  "job": {
    "jar": "job/jobs.jar",
    "mainClass": "io.github.jimzucker.flinktraining.job.PositionsJob",
    "args": "--bootstrap={bootstrap} --topicIn={in} --topicSym={out0} --topicAcct={out1} --group={group} --parallelism={par} --checkpointMs={ckptMs}",
    "sourceVertexMatch": "orders"
  },
  "generator": {
    "cmd": "{java} -Xmx2g -cp job/generators.jar:job/jobs.jar io.github.jimzucker.flinktraining.generator.HarnessBacklog --mode=produce --count={count} --seed={seed} --partitions={partitions} --bootstrap={bootstrapExt} --topic={topic} --manifest={manifest}",
    "manifestCountField": "count",
    "manifestCmd": "{java} -Xmx2g -cp job/generators.jar:job/jobs.jar io.github.jimzucker.flinktraining.generator.HarnessBacklog --mode=expect --count={count} --seed={seed} --partitions={partitions} --bootstrap={bootstrapExt} --topic={topic} --manifest={manifest}"
  },
  "verifier": {
    "cmd": "{java} -Xmx2g -cp job/generators.jar:job/jobs.jar io.github.jimzucker.flinktraining.generator.HarnessVerify --bootstrap={bootstrapExt} --symbolTopic={out0} --accountTopic={out1} --manifest={manifest}"
  },
  "cases": [
    1,
    2,
    4
  ],
  "baseline": 1,
  "passes": 3,
  "backlog": {
    "count": 150000000,
    "seed": 20260910,
    "smallCount": 4000000,
    "tinyCount": 60000000,
    "killAtFraction": 0.35
  },
  "caps": {
    "kafka": 2.5,
    "jobmanager": 0.5,
    "kafkaMemory": "4g",
    "kafkaHeap": "1G",
    "tmMemoryBase": "1024m",
    "tmMemoryPerCore": "1024m",
    "tmMemoryLimitPerCore": "1280m"
  },
  "images": {
    "flink": "flink:1.20.1-scala_2.12-java17",
    "kafka": "apache/kafka:3.9.0"
  },
  "ports": {
    "kafka": 19092,
    "rest": 18081
  },
  "jdk": "/opt/homebrew/opt/openjdk@17",
  "axis": "one worker growing: one task manager container capped at N cores, parallelism N, N slots",
  "apiLevel": "Flink DataStream API, this repository's own PositionsJob (no SQL, no Table API)",
  "guarantee": {
    "state": "exactly-once checkpointing",
    "sink": "at-least-once, idempotent by emitting the absolute position per key"
  },
  "ceilingBrokerCaps": [
    2.5,
    1.25,
    0.6
  ]
}