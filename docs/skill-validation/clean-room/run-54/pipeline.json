{
  "project": "st54",
  "topics": {
    "in": "orders",
    "out": ["positions-by-symbol", "positions-by-account"]
  },
  "topicsAlsoWritten": ["market-values-by-symbol", "market-values-by-account"],
  "design": {
    "operators": [
      "parse-orders",
      "position-mv-by-symbol",
      "position-mv-by-account",
      "sink-positions-by-symbol",
      "sink-positions-by-account",
      "sink-market-values-by-symbol",
      "sink-market-values-by-account"
    ],
    "inputs": ["orders", "prices"],
    "every": {"market-values-by-symbol": "10 s", "market-values-by-account": "10 s"},
    "sources": {"prices": "prices-source"}
  },
  "partitions": 8,
  "outputsPerInput": 5,
  "checkpointMs": 10000,
  "settleS": 15,
  "job": {
    "jar": "job/target/positions-1.0.jar",
    "mainClass": "st54.PositionsJob",
    "args": "--bootstrap {bootstrap} --orders {in} --prices {in1} --posSym {out0} --posAcct {out1} --mvSym {also0} --mvAcct {also1} --group {group} --parallelism {par} --checkpointMs {ckptMs} --partitions {partitions} --mvIntervalMs 10000",
    "sourceVertexMatch": "orders-source"
  },
  "generator": {
    "cmd": "{java} -cp {jar} st54.Generate --mode=produce --count={count} --seed={seed} --partitions={partitions} --bootstrap={bootstrapExt} --topic={topic} --prices={in1} --manifest={manifest}",
    "manifestCmd": "{java} -cp {jar} st54.Generate --mode=manifest --count={count} --seed={seed} --partitions={partitions} --manifest={manifest}",
    "manifestCountField": "tradeCount"
  },
  "verifier": {
    "cmd": "{java} -cp {jar} st54.Verify --bootstrap={bootstrapExt} --posSym={out0} --posAcct={out1} --mvSym={also0} --mvAcct={also1} --manifest={manifest} --arm={arm}"
  },
  "keySets": {
    "position-mv-by-symbol": "totalBySymbol",
    "position-mv-by-account": "totalByAccount"
  },
  "cases": [1, 2, 4],
  "baseline": 1,
  "passes": 3,
  "backlog": {
    "count": 250000000,
    "seed": 20261012,
    "smallCount": 6000000,
    "tinyCount": 150000000,
    "killAtFraction": 0.35
  },
  "caps": {
    "kafka": 2.5,
    "jobmanager": 0.5,
    "kafkaMemory": "5632m",
    "kafkaHeap": "1G",
    "tmMemoryBase": "1024m",
    "tmMemoryPerCore": "512m"
  },
  "images": {
    "flink": "flink:1.20.1-scala_2.12-java17",
    "kafka": "apache/kafka:3.9.0",
    "kafkaLibs": "/opt/kafka/libs"
  },
  "flinkProperties": {
    "env.java.opts.taskmanager": "-XX:+UseG1GC",
    "metrics.reporter.prom.factory.class": "org.apache.flink.metrics.prometheus.PrometheusReporterFactory",
    "metrics.reporter.prom.port": "9249"
  },
  "extraServices": {
    "statsexporter": {
      "image": "python:3.12-alpine",
      "container_name": "st54-statsexporter",
      "hostname": "st54-statsexporter",
      "cpus": 0.2,
      "mem_limit": "128m",
      "environment": {"PREFIX": "st54-"},
      "command": ["python3", "/app/docker_cpu_exporter.py"],
      "volumes": [
        "~/code/GitHub/flink-skill-test-54/dashboard/exporter:/app:ro",
        "/var/run/docker.sock:/var/run/docker.sock:ro"
      ]
    },
    "prometheus": {
      "image": "prom/prometheus:v2.53.2",
      "container_name": "st54-prometheus",
      "hostname": "st54-prometheus",
      "cpus": 0.3,
      "mem_limit": "512m",
      "command": ["--config.file=/etc/prometheus/prometheus.yml", "--storage.tsdb.retention.time=30d"],
      "ports": ["19090:9090"],
      "volumes": ["~/code/GitHub/flink-skill-test-54/dashboard/prometheus:/etc/prometheus:ro"]
    },
    "grafana": {
      "image": "grafana/grafana:11.2.0",
      "container_name": "st54-grafana",
      "hostname": "st54-grafana",
      "cpus": 0.3,
      "mem_limit": "256m",
      "ports": ["13000:3000"],
      "environment": {
        "GF_AUTH_ANONYMOUS_ENABLED": "true",
        "GF_AUTH_ANONYMOUS_ORG_ROLE": "Admin",
        "GF_SECURITY_ADMIN_PASSWORD": "admin"
      },
      "volumes": [
        "~/code/GitHub/flink-skill-test-54/dashboard/grafana/provisioning:/etc/grafana/provisioning:ro",
        "~/code/GitHub/flink-skill-test-54/dashboard/grafana/dashboards:/var/lib/grafana/dashboards:ro"
      ]
    }
  },
  "ports": {"kafka": 19092, "rest": 18081},
  "jdk": "/opt/homebrew/opt/openjdk@17",
  "axis": "one machine, more cores: one task manager container capped at N cores, parallelism N, N slots",
  "apiLevel": "Flink DataStream API, hand-written operators (no SQL, no Table API)",
  "guarantee": {
    "state": "exactly-once checkpointing every 10 s",
    "sink": "at-least-once Kafka sinks, idempotent by publishing the absolute position per key"
  }
}
