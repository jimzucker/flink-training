{
  "project": "st53",
  "topics": {
    "in": "orders",
    "out": ["positions-by-symbol", "positions-by-account"]
  },
  "topicsAlsoWritten": ["market-values-by-symbol", "market-values-by-account"],
  "design": {
    "operators": [
      "order-source",
      "parse",
      "prices-source",
      "parse-prices",
      "position-mv-by-symbol",
      "position-mv-by-account",
      "sink-positions-by-symbol",
      "sink-positions-by-account",
      "sink-market-values-by-symbol",
      "sink-market-values-by-account"
    ],
    "inputs": ["orders", "prices"],
    "sources": {"prices": "prices-source"},
    "every": {"market-values-by-symbol": "10 s", "market-values-by-account": "10 s"}
  },
  "partitions": 8,
  "outputsPerInput": 5,
  "checkpointMs": 10000,
  "settleS": 25,
  "job": {
    "jar": "job/target/st53-1.0.jar",
    "mainClass": "st53.PositionsJob",
    "args": "--bootstrap {bootstrap} --in {in} --prices {in1} --outSym {out0} --outAcct {out1} --mvSym {also0} --mvAcct {also1} --group {group} --parallelism {par} --checkpointMs {ckptMs} --partitions {partitions} --mvIntervalMs 10000",
    "sourceVertexMatch": "order-source"
  },
  "generator": {
    "cmd": "{java} -Xmx2g -cp {jar} st53.GenerateBacklog --mode=produce --count={count} --seed={seed} --partitions={partitions} --bootstrap={bootstrapExt} --topic={topic} --prices={in1} --manifest={manifest}",
    "manifestCmd": "{java} -cp {jar} st53.GenerateBacklog --mode=manifest --count={count} --seed={seed} --partitions={partitions} --manifest={manifest}",
    "manifestCountField": "records"
  },
  "verifier": {
    "cmd": "{java} -Xmx2g -cp {jar} st53.VerifyCompleteness --bootstrap={bootstrapExt} --topicSym={out0} --topicAcct={out1} --mvSym={also0} --mvAcct={also1} --manifest={manifest} --arm={arm}"
  },
  "keySets": {
    "by-symbol": "positionBySymbol",
    "by-account": "positionByAccount"
  },
  "cases": [1, 2, 4],
  "baseline": 1,
  "passes": 3,
  "backlog": {
    "count": 250000000,
    "seed": 53,
    "smallCount": 15000000,
    "tinyCount": 180000000,
    "killAtFraction": 0.35
  },
  "caps": {
    "kafka": 2.5,
    "jobmanager": 0.5,
    "kafkaMemory": "5g",
    "kafkaHeap": "768m",
    "tmMemoryBase": "1024m",
    "tmMemoryPerCore": "640m",
    "tmMemoryLimitPerCore": "800m"
  },
  "images": {
    "flink": "flink:1.20.1-scala_2.12-java17",
    "kafka": "apache/kafka:3.9.0",
    "kafkaLibs": "/opt/kafka/libs"
  },
  "flinkProperties": {
    "env.java.opts.taskmanager": "-XX:+UseG1GC",
    "metrics.reporter.prom.factory.class": "org.apache.flink.metrics.prometheus.PrometheusReporterFactory",
    "metrics.reporter.prom.port": "9249"
  },
  "ports": {"kafka": 19092, "rest": 18081},
  "extraServices": {
    "statsexporter": {
      "image": "python:3.12-alpine",
      "container_name": "st53-statsexporter",
      "hostname": "st53-statsexporter",
      "cpus": 0.2,
      "mem_limit": "128m",
      "environment": {"PREFIX": "st53-"},
      "command": ["python3", "/app/docker_cpu_exporter.py"],
      "volumes": ["~/code/GitHub/flink-skill-test-53/dashboard/exporter:/app:ro", "/var/run/docker.sock:/var/run/docker.sock:ro"]
    },
    "prometheus": {
      "image": "prom/prometheus:v2.53.2",
      "container_name": "st53-prometheus",
      "hostname": "st53-prometheus",
      "cpus": 0.3,
      "mem_limit": "512m",
      "command": ["--config.file=/etc/prometheus/prometheus.yml", "--storage.tsdb.retention.time=30d"],
      "ports": ["\"19090:9090\""],
      "volumes": ["~/code/GitHub/flink-skill-test-53/dashboard/prometheus:/etc/prometheus:ro"]
    },
    "grafana": {
      "image": "grafana/grafana:11.2.0",
      "container_name": "st53-grafana",
      "hostname": "st53-grafana",
      "cpus": 0.3,
      "mem_limit": "256m",
      "environment": {
        "GF_AUTH_ANONYMOUS_ENABLED": "\"true\"",
        "GF_AUTH_ANONYMOUS_ORG_ROLE": "Admin",
        "GF_SECURITY_ADMIN_PASSWORD": "admin"
      },
      "ports": ["\"13000:3000\""],
      "volumes": [
        "~/code/GitHub/flink-skill-test-53/dashboard/grafana/provisioning:/etc/grafana/provisioning:ro",
        "~/code/GitHub/flink-skill-test-53/dashboard/grafana/dashboards:/var/lib/grafana/dashboards:ro"
      ]
    }
  },
  "jdk": "/opt/homebrew/opt/openjdk@17",
  "axis": "one machine, more cores: one task manager container capped at N cores, parallelism N, N slots",
  "apiLevel": "Flink DataStream API, hand-written operators (no SQL, no Table API)",
  "guarantee": {
    "state": "exactly-once checkpointing every 10 s",
    "sink": "at-least-once Kafka sinks, idempotent by publishing the absolute position per key"
  }
}
