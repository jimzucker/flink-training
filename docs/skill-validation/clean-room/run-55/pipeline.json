{
  "project": "st55",
  "topics": {
    "in": "orders",
    "out": ["positions-by-symbol", "positions-by-account"]
  },
  "topicsAlsoWritten": ["market-values-by-symbol", "market-values-by-account"],
  "outputsPerInput": 5,
  "design": {
    "operators": [
      "kafka-source-orders",
      "parse-orders",
      "kafka-source-prices",
      "parse-prices",
      "position-mv-by-symbol",
      "position-mv-by-account",
      "sink-positions-by-symbol",
      "sink-positions-by-account",
      "sink-market-values-by-symbol",
      "sink-market-values-by-account"
    ],
    "inputs": ["orders", "prices"],
    "sources": {"prices": "kafka-source-prices"},
    "every": {"market-values-by-symbol": "10 s", "market-values-by-account": "10 s"}
  },
  "partitions": 8,
  "checkpointMs": 5000,
  "settleS": 20,
  "job": {
    "jar": "job/target/positions-1.0.jar",
    "mainClass": "st55.PositionsJob",
    "args": "--bootstrap {bootstrap} --in {in} --prices {in1} --outSym {out0} --outAcct {out1} --mvSym {also0} --mvAcct {also1} --group {group} --par {par} --ckptMs {ckptMs} --mvIntervalMs 10000",
    "sourceVertexMatch": "kafka-source-orders"
  },
  "generator": {
    "cmd": "{java} -cp {jar} st55.Gen --mode=produce --count={count} --seed={seed} --partitions={partitions} --bootstrap={bootstrapExt} --topic={topic} --pricesTopic={in1} --manifest={manifest}",
    "manifestCmd": "{java} -cp {jar} st55.Gen --mode=manifest --count={count} --seed={seed} --partitions={partitions} --manifest={manifest}",
    "manifestCountField": "recordCount"
  },
  "verifier": {
    "cmd": "{java} -cp {jar} st55.Verify --bootstrap={bootstrapExt} --outSym={out0} --outAcct={out1} --mvSym={also0} --mvAcct={also1} --manifest={manifest} --arm={arm}"
  },
  "keySets": {
    "positions-by-symbol": "symbolKeys",
    "positions-by-account": "accountKeys"
  },
  "cases": [1, 2, 4],
  "baseline": 1,
  "passes": 3,
  "backlog": {
    "count": 300000000,
    "seed": 20261014,
    "smallCount": 10000000,
    "tinyCount": 120000000,
    "killAtFraction": 0.4
  },
  "caps": {
    "kafka": 2.5,
    "jobmanager": 0.5,
    "kafkaMemory": "5632m",
    "kafkaHeap": "1G",
    "tmMemoryBase": "1024m",
    "tmMemoryPerCore": "640m"
  },
  "images": {
    "flink": "flink:1.20.1-scala_2.12-java17",
    "kafka": "apache/kafka:3.9.0",
    "kafkaLibs": "/opt/kafka/libs"
  },
  "flinkProperties": {
    "env.java.opts.taskmanager": "-XX:+UseG1GC",
    "metrics.reporter.prom.factory.class": "org.apache.flink.metrics.prometheus.PrometheusReporterFactory",
    "metrics.reporter.prom.port": "9249"
  },
  "extraServices": {
    "statsexporter": {
      "image": "python:3.12-alpine",
      "container_name": "st55-statsexporter",
      "hostname": "st55-statsexporter",
      "cpus": 0.2,
      "mem_limit": "128m",
      "environment": {"PREFIX": "st55-"},
      "command": ["python3", "/app/docker_cpu_exporter.py"],
      "volumes": [
        "~/code/GitHub/flink-skill-test-55/dashboard/exporter:/app:ro",
        "/var/run/docker.sock:/var/run/docker.sock:ro"
      ]
    },
    "prometheus": {
      "image": "prom/prometheus:v2.53.2",
      "container_name": "st55-prometheus",
      "hostname": "st55-prometheus",
      "cpus": 0.3,
      "mem_limit": "512m",
      "ports": ["19090:9090"],
      "command": ["--config.file=/etc/prometheus/prometheus.yml", "--storage.tsdb.retention.time=30d"],
      "volumes": ["~/code/GitHub/flink-skill-test-55/dashboard/prometheus:/etc/prometheus:ro"]
    },
    "grafana": {
      "image": "grafana/grafana:11.2.0",
      "container_name": "st55-grafana",
      "hostname": "st55-grafana",
      "cpus": 0.3,
      "mem_limit": "384m",
      "ports": ["13000:3000"],
      "environment": {
        "GF_AUTH_ANONYMOUS_ENABLED": "true",
        "GF_AUTH_ANONYMOUS_ORG_ROLE": "Admin",
        "GF_USERS_DEFAULT_THEME": "light"
      },
      "volumes": [
        "~/code/GitHub/flink-skill-test-55/dashboard/grafana/provisioning:/etc/grafana/provisioning:ro",
        "~/code/GitHub/flink-skill-test-55/dashboard/grafana/dashboards:/var/lib/grafana/dashboards:ro"
      ]
    }
  },
  "ports": {"kafka": 19092, "rest": 18081},
  "jdk": "/opt/homebrew/opt/openjdk@17",
  "axis": "one machine, more cores: one task manager container capped at N cores, parallelism N, N slots",
  "apiLevel": "Flink DataStream API (KeyedBroadcastProcessFunction per key space), Flink 1.20.1",
  "guarantee": {
    "state": "exactly-once checkpointing every 5 s",
    "sink": "at-least-once Kafka sinks, idempotent by emitting the absolute position per key"
  }
}
