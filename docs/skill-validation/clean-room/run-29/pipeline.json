{
  "project": "bt30",
  "topics": {
    "in": "block-trades",
    "out": [
      "positions-by-symbol",
      "positions-by-account",
      "mv-by-symbol",
      "mv-by-account"
    ]
  },
  "partitions": 8,
  "outputsPerInput": 5,
  "checkpointMs": 5000,
  "job": {
    "jar": "job/target/positions-1.0.jar",
    "mainClass": "scaletest.PositionsJob",
    "args": "--bootstrap={bootstrap} --topicIn={in} --topicPrices={in}-prices --topicPosSym={out0} --topicPosAcct={out1} --topicMvSym={out2} --topicMvAcct={out3} --group={group} --parallelism={par} --checkpointMs={ckptMs}",
    "sourceVertexMatch": "trades-source"
  },
  "generator": {
    "cmd": "{java} -Xmx2g -cp {jar} scaletest.GenerateBacklog --mode=produce --count={count} --seed={seed} --partitions={partitions} --bootstrap={bootstrapExt} --topic={topic} --pricesTopic={topic}-prices --manifest={manifest}",
    "manifestCmd": "{java} -Xmx2g -cp {jar} scaletest.GenerateBacklog --mode=manifest --count={count} --seed={seed} --partitions={partitions} --manifest={manifest}",
    "manifestCountField": "tradeCount"
  },
  "verifier": {
    "cmd": "{java} -Xmx5g -cp {jar} scaletest.VerifyCompleteness --bootstrap={bootstrapExt} --topicPosSym={out0} --topicPosAcct={out1} --topicMvSym={out2} --topicMvAcct={out3} --manifest={manifest}"
  },
  "cases": [
    1,
    2,
    4
  ],
  "baseline": 1,
  "passes": 3,
  "backlog": {
    "count": 50000000,
    "seed": 20260910,
    "smallCount": 1500000,
    "tinyCount": 80000000,
    "killAtFraction": 0.35
  },
  "caps": {
    "kafka": 2.5,
    "jobmanager": 0.5,
    "kafkaMemory": "6400m",
    "kafkaHeap": "1G",
    "tmMemoryBase": "1280m",
    "tmMemoryPerCore": "768m"
  },
  "images": {
    "flink": "flink:1.20.1-scala_2.12-java17",
    "kafka": "apache/kafka:3.9.0"
  },
  "ports": {
    "kafka": 19230,
    "rest": 18230
  },
  "jdk": "/opt/homebrew/opt/openjdk@17",
  "axis": "one worker growing: one task manager container capped at N cores, parallelism N, N slots",
  "apiLevel": "Flink DataStream API, hand-written operators (no SQL, no Table API)",
  "guarantee": {
    "state": "exactly-once checkpointing",
    "sink": "at-least-once, idempotent by emitting the absolute position per key and the absolute market value per key per window"
  },
  "checkpointMsNote": "5000 ms, fixed by the study"
}