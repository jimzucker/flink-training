{
  "project": "st52",
  "topics": {
    "in": "orders",
    "out": ["positions-by-symbol", "positions-by-account"]
  },
  "outputsPerInput": 4.975,
  "topicsAlsoWritten": ["market-values-by-symbol", "market-values-by-account"],
  "design": {
    "operators": [
      "orders-source",
      "parse-orders",
      "prices-source",
      "position-by-symbol",
      "position-by-account",
      "sink-positions-by-symbol",
      "sink-positions-by-account",
      "sink-market-values-by-symbol",
      "sink-market-values-by-account"
    ],
    "inputs": ["orders", "prices"],
    "every": {"market-values-by-symbol": "10 s", "market-values-by-account": "10 s"}
  },
  "partitions": 8,
  "checkpointMs": 10000,
  "settleS": 25,
  "job": {
    "jar": "job/target/positions-1.0.jar",
    "mainClass": "st52.PositionsJob",
    "args": "--bootstrap={bootstrap} --in={in} --prices=prices --outSym={out0} --outAcct={out1} --mvSym={also0} --mvAcct={also1} --group={group} --parallelism={par} --checkpointMs={ckptMs} --mvIntervalMs=10000",
    "sourceVertexMatch": "orders-source"
  },
  "generator": {
    "cmd": "{java} -Xmx1g -cp {jar} st52.Generate --mode=produce --count={count} --seed={seed} --partitions={partitions} --bootstrap={bootstrapExt} --topic={topic} --manifest={manifest} --prices=prices --alsoTopics={alsos} --dupEvery=200",
    "manifestCmd": "{java} -Xmx1g -cp {jar} st52.Generate --mode=manifest --count={count} --seed={seed} --manifest={manifest} --dupEvery=200",
    "manifestCountField": "recordCount"
  },
  "verifier": {
    "cmd": "{java} -Xmx2g -cp {jar} st52.Verify --bootstrap={bootstrapExt} --manifest={manifest} --arm={arm} --posSym={out0} --posAcct={out1} --mvSym={also0} --mvAcct={also1}"
  },
  "keySets": {
    "position-by-symbol": "symbolKeys",
    "position-by-account": "accountKeys"
  },
  "cases": [1, 2, 4],
  "baseline": 1,
  "passes": 3,
  "backlog": {
    "count": 200000000,
    "seed": 5201,
    "smallCount": 10000000,
    "tinyCount": 100000000,
    "killAtFraction": 0.4
  },
  "caps": {
    "kafka": 2.5,
    "jobmanager": 0.5,
    "kafkaMemory": "4352m",
    "kafkaHeap": "1G",
    "tmMemoryBase": "1024m",
    "tmMemoryPerCore": "512m"
  },
  "images": {
    "flink": "flink:1.20.1-scala_2.12-java17",
    "kafka": "apache/kafka:3.9.0",
    "kafkaLibs": "/opt/kafka/libs"
  },
  "flinkProperties": {
    "env.java.opts.taskmanager": "-XX:+UseG1GC",
    "metrics.reporter.prom.factory.class": "org.apache.flink.metrics.prometheus.PrometheusReporterFactory",
    "metrics.reporter.prom.port": "9249",
    "metrics.reporter.prom.filterLabelValueCharacters": "false"
  },
  "extraServices": {
    "statsexporter": {
      "image": "python:3.12-alpine",
      "container_name": "st52-statsexporter",
      "hostname": "st52-statsexporter",
      "cpus": 0.2,
      "mem_limit": "128m",
      "environment": {"PREFIX": "st52-"},
      "command": ["python3", "/app/docker_cpu_exporter.py"],
      "volumes": [
        "<run-dir>/dashboard/exporter:/app:ro",
        "/var/run/docker.sock:/var/run/docker.sock:ro"
      ]
    },
    "prometheus": {
      "image": "prom/prometheus:v2.53.2",
      "container_name": "st52-prometheus",
      "hostname": "st52-prometheus",
      "cpus": 0.3,
      "mem_limit": "384m",
      "ports": ["\"19090:9090\""],
      "command": ["--config.file=/etc/prometheus/prometheus.yml", "--storage.tsdb.path=/prometheus", "--storage.tsdb.retention.time=30d"],
      "volumes": ["<run-dir>/dashboard/prometheus:/etc/prometheus:ro"]
    },
    "grafana": {
      "image": "grafana/grafana:11.2.0",
      "container_name": "st52-grafana",
      "hostname": "st52-grafana",
      "cpus": 0.3,
      "mem_limit": "256m",
      "ports": ["\"13000:3000\""],
      "environment": {
        "GF_AUTH_ANONYMOUS_ENABLED": "\"true\"",
        "GF_AUTH_ANONYMOUS_ORG_ROLE": "Viewer",
        "GF_SECURITY_ADMIN_PASSWORD": "admin"
      },
      "volumes": ["<run-dir>/dashboard/provisioning:/etc/grafana/provisioning:ro"]
    }
  },
  "ports": {"kafka": 19092, "rest": 18081},
  "jdk": "/opt/homebrew/opt/openjdk@17",
  "axis": "one machine, more cores: one task manager container capped at N cores, parallelism N, N slots",
  "apiLevel": "Flink DataStream API, hand-written operators",
  "api": "datastream",
  "guarantee": {
    "state": "exactly-once checkpointing",
    "sink": "at-least-once, idempotent by publishing the absolute position per key"
  }
}
