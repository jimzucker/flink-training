{
  "project": "blk28",
  "topics": {
    "in": "block-trades",
    "out": [
      "positions-by-symbol",
      "positions-by-account",
      "mv-by-symbol",
      "mv-by-account"
    ]
  },
  "partitions": 8,
  "outputsPerInput": 6,
  "checkpointMs": 10000,
  "job": {
    "jar": "job/target/blockmv-1.0.jar",
    "mainClass": "blockmv.BlockMarketValueJob",
    "args": "--bootstrap={bootstrap} --topicIn={in} --topicPrices={in}-prices --topicPosSym={out0} --topicPosAcct={out1} --topicMvSym={out2} --topicMvAcct={out3} --group={group} --parallelism={par} --checkpointMs={ckptMs}",
    "sourceVertexMatch": "kafka-source"
  },
  "generator": {
    "cmd": "{java} -cp {jar} blockmv.GenerateBacklog --mode=produce --count={count} --seed={seed} --partitions={partitions} --bootstrap={bootstrapExt} --topic={topic} --pricesTopic={topic}-prices --manifest={manifest}",
    "manifestCmd": "{java} -cp {jar} blockmv.GenerateBacklog --mode=manifest --count={count} --seed={seed} --partitions={partitions} --manifest={manifest}",
    "manifestCountField": "tradeCount"
  },
  "verifier": {
    "cmd": "{java} -cp {jar} blockmv.VerifyCompleteness --bootstrap={bootstrapExt} --manifest={manifest} --topicPosSym={out0} --topicPosAcct={out1} --topicMvSym={out2} --topicMvAcct={out3}"
  },
  "cases": [
    1,
    2,
    4
  ],
  "baseline": 1,
  "passes": 3,
  "backlog": {
    "count": 160000000,
    "seed": 20260909,
    "smallCount": 6000000,
    "tinyCount": 70000000,
    "killAtFraction": 0.4
  },
  "caps": {
    "kafka": 2.5,
    "jobmanager": 0.5,
    "tmMemoryBase": "2048m",
    "tmMemoryPerCore": "256m",
    "tmMemoryLimitPerCore": "640m",
    "kafkaMemory": "3g",
    "kafkaHeap": "1G"
  },
  "images": {
    "flink": "flink:1.20.1-scala_2.12-java17",
    "kafka": "apache/kafka:3.9.0"
  },
  "ports": {
    "kafka": 19092,
    "rest": 18081
  },
  "jdk": "/opt/homebrew/opt/openjdk@17",
  "axis": "one worker growing: one task manager container capped at N cores, parallelism N, N slots",
  "apiLevel": "Flink DataStream API, hand-written operators and event-time timers (no SQL, no Table API, no window API)",
  "guarantee": {
    "state": "exactly-once checkpointing (aligned, 10 s interval, hashmap backend, offsets committed on checkpoint)",
    "sink": "at-least-once, idempotent by key: running positions carry the absolute position per key, and windowed market values are keyed by (key, window end) and carry a value that is a pure function of the input"
  }
}
